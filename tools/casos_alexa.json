{
  "descripcion": "Casos de prueba de la skill. Los usan tools/probar_lambda.py (invoca la Lambda desplegada) y tools/probar_alexa.py (simulador de Alexa con la ASK CLI). 'espera' es una expresion regular sin distinguir mayusculas; '|' separa respuestas validas. {codigo} se reemplaza por --codigo.",
  "casos": [
    {
      "id": "C01",
      "nombre": "Bienvenida",
      "alexa": [
        [
          "abre tendedero inteligente",
          "Bienvenido al tendedero"
        ]
      ],
      "lambda": {
        "tipo": "LaunchRequest"
      },
      "espera": "Bienvenido al tendedero"
    },
    {
      "id": "C02",
      "nombre": "Limpiar vinculo previo",
      "alexa": [
        [
          "desvincula mi tendedero",
          "He eliminado la vinculación|No tienes ningún tendedero"
        ]
      ],
      "lambda": {
        "intent": "DesvincularThingIntent"
      },
      "espera": "He eliminado la vinculación|No tienes ningún tendedero"
    },
    {
      "id": "C03",
      "nombre": "Consulta sin vinculo",
      "alexa": [
        [
          "hay agua en el sensor",
          "No tienes un tendedero vinculado"
        ]
      ],
      "lambda": {
        "intent": "ConsultarAguaIntent"
      },
      "espera": "No tienes un tendedero vinculado"
    },
    {
      "id": "C04",
      "nombre": "Codigo inexistente",
      "alexa": [
        [
          "vincula mi tendedero con el código 999999",
          "Es correcto"
        ],
        [
          "sí",
          "No encontré un tendedero"
        ]
      ],
      "lambda": {
        "intent": "VincularThingIntent",
        "slots": {
          "codigo": "999999"
        }
      },
      "espera": "No encontré un tendedero"
    },
    {
      "id": "C05",
      "nombre": "Codigo mal formado (solo Lambda)",
      "lambda": {
        "intent": "VincularThingIntent",
        "slots": {
          "codigo": "12345"
        }
      },
      "espera": "seis dígitos"
    },
    {
      "id": "C06",
      "nombre": "Vincular pidiendo el codigo",
      "alexa": [
        [
          "vincula mi tendedero",
          "Dime el código"
