{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GuardarHistorico",
      "Effect": "Allow",
      "Action": "dynamodb:PutItem",
      "Resource": "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/tendedero_historico"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/tendedero_almacenamiento:*"
    }
  ]
}
