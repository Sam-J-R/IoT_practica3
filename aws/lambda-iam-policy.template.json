{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeAllowedTendederos",
      "Effect": "Allow",
      "Action": ["iot:DescribeThing"],
      "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:thing/tendedero-*"
    },
    {
      "Sid": "ReadWriteThingShadows",
      "Effect": "Allow",
      "Action": ["iot:GetThingShadow", "iot:UpdateThingShadow"],
      "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:thing/tendedero-*"
    },
    {
      "Sid": "PersistUserBindings",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:DeleteItem"],
      "Resource": "arn:aws:dynamodb:REGION:ACCOUNT_ID:table/tendedero_vinculaciones"
    }
  ]
}

