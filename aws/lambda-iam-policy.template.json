{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AccessThingRegistryAndShadows",
      "Effect": "Allow",
      "Action": [
        "iot:DescribeThing",
        "iot:GetThingShadow",
        "iot:UpdateThingShadow"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PersistUserBindings",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/tendedero_vinculaciones"
    }
  ]
}